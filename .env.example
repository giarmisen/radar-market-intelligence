# Supabase (Settings > API en el panel de Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa de solo lectura para scripts locales que no necesiten escribir.
# En produccion usa siempre SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_ANON_KEY=

# Anthropic (enriquecimiento con Haiku, informes con Sonnet)
ANTHROPIC_API_KEY=

# Gmail (fuente de Google Alerts)
GMAIL_CREDENTIALS_PATH=
GMAIL_ALERT_INBOX=

# RSS / EDGAR
RSS_USER_AGENT=
EDGAR_USER_AGENT=

# Dominio activo (ver lib/config-loader)
DOMAIN=

# --- Auth para las rutas de escritura/admin (middleware.ts) ---
# Usuario y contraseña que pedira el navegador (HTTP Basic Auth) para entrar
# a /proposals y llamar a /api/ingest, /api/enrich*, /api/reports, /api/seed,
# /api/proposals*, /api/analysis*. Sin estas dos variables, esas rutas
# devuelven 401 a todo el mundo (fail closed), incluida tu.
ADMIN_USER=
ADMIN_PASSWORD=

# Secreto que Vercel Cron manda solo (Settings > Environment Variables, luego
# Vercel lo añade automaticamente como "Authorization: Bearer <CRON_SECRET>"
# en la llamada programada a /api/ingest). Genera un valor random largo,
# por ejemplo con: openssl rand -hex 32
CRON_SECRET=
